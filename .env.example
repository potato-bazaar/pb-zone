# PB Zone Web — copy to `.env.local` and restart `npm run dev`

# Potato Bazaar user profile proxy (used by /api/user/profile)
API_BASE_URL=https://api.potatobazaar.com/api/
USER_PROFILE_ENDPOINT=users/mobile/user_profile

# Staging
# API_BASE_URL=https://api.staging.potatobazaar.com/api/

# Quiz / leaderboard / admin BE
# Admin panel calls this host directly (visible in DevTools as Request URL).
# Game quiz/leaderboard still go through Next /api/* when USE_PROXY=true.
QUIZ_API_BASE_URL=https://pbzone-api.potatobazaar.com
NEXT_PUBLIC_QUIZ_API_BASE_URL=https://pbzone-api.potatobazaar.com
# Game client: same-origin /api/quiz + /api/leaderboard (avoids CORS in WebView)
NEXT_PUBLIC_QUIZ_USE_PROXY=true
# Only if TLS hostname mismatches
# QUIZ_API_TLS_INSECURE=true

# Must match BE ADMIN_API_KEY — required for /admin live questions (x-admin-key)
QUIZ_ADMIN_API_KEY=pbzone-admin-dev-key

# Local/dev: proxy auto-signs Bearer JWT when WebView token is missing
# Must match BE JWT_SECRET
QUIZ_JWT_SECRET=MySuperSecretKey@2024!$
QUIZ_DEV_AUTO_TOKEN=true
QUIZ_DEV_USER_ID=dev-user-1
QUIZ_DEV_USER_NAME=Potato Player

# Optional: also send x-user-id headers (needs BE AUTH_DEV_BYPASS=true)
# NEXT_PUBLIC_QUIZ_AUTH_DEV_BYPASS=true
# NEXT_PUBLIC_QUIZ_DEV_USER_ID=dev-user-1
# NEXT_PUBLIC_QUIZ_DEV_USER_NAME=Potato Player

# Client-visible fallback name only
NEXT_PUBLIC_DEFAULT_USER_NAME=Potato Player

# Optional. Vercel Cron sends Authorization: Bearer CRON_SECRET
# to /api/cron/quiz-bank-cap (11:00 AM IST) so the live bank stays at 600.
# CRON_SECRET=
