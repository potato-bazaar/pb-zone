{
  "name": "pb-zone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,admin -c cyan,magenta \"next dev -p 3000\" \"npm --prefix admin run dev\"",
    "dev:web": "next dev -p 3000",
    "dev:admin": "npm --prefix admin run dev",
    "tunnel": "ngrok http 3000",
    "build": "npm --prefix admin install --include=dev && npm --prefix admin run build && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm --prefix admin install --include=dev"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "16.3.2",
    "pixi.js": "^8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
