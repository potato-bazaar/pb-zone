{
  "name": "pb-zone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n zone,admin -c cyan,magenta \"next dev -p 3002\" \"npm run dev --prefix admin\"",
    "dev:zone": "next dev -p 3002",
    "dev:admin": "npm run dev --prefix admin",
    "build": "npm run build --prefix admin && node scripts/sync-admin.mjs && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "16.3.2",
    "pixi.js": "^8.20.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
